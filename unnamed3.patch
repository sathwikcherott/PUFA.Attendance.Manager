+@Composable
+fun AttendanceHistoryDashboard(
+    players: List<Player>,
+    batches: List<Batch>,
+    allAttendance: List<Attendance>,
+    selectedBatch: Batch?
+) {
+    val groupedAttendance = remember(allAttendance, selectedBatch, players, batches) {
+        allAttendance.groupBy { it.date }.mapValues { entry ->
+            val dailyRecs = entry.value
+            batches.filter { b -> selectedBatch == null || b.id == selectedBatch.id }.map { batch ->
+                val batchPlayers = players.filter { it.batchId == batch.id }
+                val present = dailyRecs.count { it.isPresent && batchPlayers.any { p -> p.id == it.playerId } }
+                val total = batchPlayers.size
+                Triple(batch, present, total)
+            }.filter { it.third > 0 }
+        }.filter { it.value.isNotEmpty() }.toSortedMap(compareByDescending { it })
+    }
+
+    if (groupedAttendance.isEmpty()) {
+        EmptyHistoryPlaceholder("No attendance records found")
+    } else {
+        LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp), contentPadding = PaddingValues(bottom = 24.dp)) {
+            groupedAttendance.forEach { (date, batchStats) ->
+                item(key = "date_$date") {
+                    Text(
+                        formatDisplayDate(date),
+                        style = MaterialTheme.typography.labelLarge,
+                        color = MaterialTheme.colorScheme.secondary,
+                        modifier = Modifier.padding(vertical = 4.dp)
+                    )
+                }
+                items(batchStats, key = { "att_${date}_${it.first.id}" }) { stats ->
+                    HistoryCard(
+                        title = stats.first.name,
+                        subtitle = "${stats.second} / ${stats.third} Present",
+                        progress = if (stats.third > 0) stats.second.toFloat() / stats.third else 0f,
+                        color = if (stats.second == stats.third) Color(0xFF2E7D32) else if (stats.second < stats.third / 2) MaterialTheme.colorScheme.error else Color(0xFFFBC02D)
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+fun PaymentHistoryDashboard(
+    players: List<Player>,
+    batches: List<Batch>,
+    allPayments: List<Payment>,
+    selectedBatch: Batch?
+) {
+    val groupedPayments = remember(allPayments, selectedBatch, players, batches) {
+        allPayments.groupBy { it.month }.mapValues { entry ->
+            val monthlyRecs = entry.value
+            batches.filter { b -> selectedBatch == null || b.id == selectedBatch.id }.map { batch ->
+                val batchPlayers = players.filter { it.batchId == batch.id }
+                val nonExempted = batchPlayers.count { !it.isExempted }
+                val paid = monthlyRecs.count { rec -> batchPlayers.any { it.id == rec.playerId } }
+                Triple(batch, paid, nonExempted)
+            }.filter { it.third > 0 }
+        }.filter { it.value.isNotEmpty() }
+    }
+
+    if (groupedPayments.isEmpty()) {
+        EmptyHistoryPlaceholder("No payment records found")
+    } else {
+        LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp), contentPadding = PaddingValues(bottom = 24.dp)) {
+            groupedPayments.forEach { (month, batchStats) ->
+                item(key = "month_$month") {
+                    Text(
+                        month,
+                        style = MaterialTheme.typography.labelLarge,
+                        color = MaterialTheme.colorScheme.secondary,
+                        modifier = Modifier.padding(vertical = 4.dp)
+                    )
+                }
+                items(batchStats, key = { "pay_${month}_${it.first.id}" }) { stats ->
+                    HistoryCard(
+                        title = stats.first.name,
+                        subtitle = "${stats.second} / ${stats.third} Paid",
+                        progress = if (stats.third > 0) stats.second.toFloat() / stats.third else 0f,
+                        color = if (stats.second == stats.third) Color(0xFF2E7D32) else MaterialTheme.colorScheme.primary
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+fun ExportHistoryDashboard(
+    batches: List<Batch>,
+    selectedBatch: Batch?
+) {
+    // For now, we simulate recent exports as requested in the structure
+    val simulatedExports = remember(selectedBatch) {
+        val list = mutableListOf<ExportItem>()
+        val filtered = batches.filter { selectedBatch == null || it.id == selectedBatch.id }
+        
+        filtered.forEach { batch ->
+            list.add(ExportItem("Attendance", batch.name, "May 2025", "ZIP"))
+            list.add(ExportItem("Fees", batch.name, "May 2025", "PDF"))
+        }
+        list
+    }
+
+    if (simulatedExports.isEmpty()) {
+        EmptyHistoryPlaceholder("No recent exports")
+    } else {
+        LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp), contentPadding = PaddingValues(bottom = 24.dp)) {
+            items(simulatedExports) { item ->
+                ElevatedCard(
+                    modifier = Modifier.fillMaxWidth(),
+                    shape = MaterialTheme.shapes.medium
+                ) {
+                    Row(modifier = Modifier.padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
+                        Surface(
+                            color = MaterialTheme.colorScheme.primaryContainer.copy(alpha = 0.4f),
+                            shape = MaterialTheme.shapes.small
+                        ) {
+                            Icon(
+                                if (item.type == "Attendance") Icons.Default.Done else Icons.Default.Star,
+                                contentDescription = null,
+                                modifier = Modifier.padding(8.dp).size(20.dp),
+                                tint = MaterialTheme.colorScheme.primary
+                            )
+                        }
+                        Spacer(Modifier.width(16.dp))
+                        Column(modifier = Modifier.weight(1f)) {
+                            Text("${item.type} - ${item.batch}", style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.Bold)
+                            Text(item.identifier, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.secondary)
+                        }
+                        Surface(
+                            color = MaterialTheme.colorScheme.surfaceVariant,
+                            shape = MaterialTheme.shapes.extraSmall
+                        ) {
+                            Text(
+                                item.format,
+                                style = MaterialTheme.typography.labelSmall,
+                                modifier = Modifier.padding(horizontal = 6.dp, vertical = 2.dp),
+                                fontWeight = FontWeight.Bold
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
